<Window x:Class="StatusBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StatusBar"
        mc:Ignorable="d"
        Title="Status Bar" 
        Height="30" 
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource StatusBarBackground}">
    <Grid>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <Button x:Name="ThemeToggleButton"
                    Content="🌙"
                    Width="30"
                    Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource ButtonForeground}"
                    FontSize="12"
                    Click="ThemeToggleButton_Click"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock x:Name="ClockTextBlock"
                       Text="00:00 AM"
                       VerticalAlignment="Center"
                       Margin="5,0,5,0"
                       Foreground="{DynamicResource ButtonForeground}"
                       FontSize="13"
                       FontWeight="Medium"/>

            <Button x:Name="SettingsButton"
                    Content="⚙️"
                    Width="30"
                    Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource ButtonForeground}"
                    FontSize="12"
                    Cursor="Hand"
                    Margin="0,0,10,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
