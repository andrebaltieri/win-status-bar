<Application x:Class="StatusBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StatusBar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="StatusBarBackground" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="Black"/>
        <SolidColorBrush x:Key="ButtonHoverBackground" Color="#DCDCDC"/>
    </Application.Resources>
</Application>
